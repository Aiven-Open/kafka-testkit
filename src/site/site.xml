<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="Aiven Common Utilities">

    <bannerLeft name="Aiven Kafka Testkit" href="https://aiven-open.github.io/kafka-testkit" >
        <image src="https://aiven.io/assets/img/aiven-logo.png"/>
    </bannerLeft>

    <poweredBy>
        <logo name="Aiven" href="https://aiven.io/">
            <image src="https://aiven.io/assets/img/aiven-logo.png"/>
        </logo>
    </poweredBy>

    <body>
        <head>
            <![CDATA[
                <link rel="icon" type="image/x-icon" href="https://aiven.io/favicon.ico">
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        document.querySelectorAll('a.builtBy').forEach(function (link) {
                            link.target = '_blank';
                            link.rel = 'noopener noreferrer';
                        });
                    });
                </script>
            ]]>
        </head>

        <breadcrumbs>
            <item name="Home" href="./index.html" />
        </breadcrumbs>

        <menu name="Overview" inherit="bottom" inheritAsRef="true">
            <item name="Introduction" href="./index.html"/>
            <item name="Change log" href="./CHANGE_LOG.html" />
        </menu>

        <menu name="Getting Involved" inherit="bottom" inheritAsRef="true">
            <item name="Code of Conduct" href="./CODE_OF_CONDUCT.html" />
            <item name="Contributing" href="./contributing.html" />
            <item name="Security Policy" href="./SECURITY.html" />
        </menu>

        <menu ref="reports"/>

        <links>
            <item name="Apache Kafka" href="http://kafka.apache.org"/>
        </links>

        <footer>Copyright &amp;copy Aiven Oy. Licensed under the Apache License, Version 2.0.<![CDATA[<br/>
            Apache Commons Collection, Apache Kafka, and Apache Velocity are trademarks of The Apache Software Foundation.<br/>
            All other marks mentioned may be trademarks or registered trademarks of their respective owners.]]>
        </footer>
    </body>
    <skin>
        <groupId>org.apache.maven.skins</groupId>
        <artifactId>maven-fluido-skin</artifactId>
        <version>2.0.1</version>
    </skin>
    <custom>
        <fluidoSkin>
            <topBarEnabled>false</topBarEnabled>
            <sideBarEnabled>true</sideBarEnabled>
            <skipGenerationDate>true</skipGenerationDate>
            <gitHub>
                <projectId>aiven-open/kafka-testkit</projectId>
                <ribbonOrientation>right</ribbonOrientation>
                <ribbonColor>orange</ribbonColor>
            </gitHub>
        </fluidoSkin>
    </custom>
</site>